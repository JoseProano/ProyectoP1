# Configuración del servidor
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=production

# Base de datos MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=secure_chat_db

# Redis para sesiones
REDIS_URL=redis://localhost:6379/0

# Seguridad JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encriptación AES
AES_KEY=your-32-byte-aes-key-change-this-now!
ENCRYPTION_KEY=your-encryption-key-minimum-32-characters-long

# Administrador por defecto
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!@#
ADMIN_EMAIL=admin@securechat.local

# Configuración de archivos
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain
UPLOAD_DIR=./uploads

# Detección de esteganografía
ENTROPY_THRESHOLD=7.5
ENABLE_STEGO_DETECTION=True

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# SSL/TLS
SSL_KEYFILE=
SSL_CERTFILE=
